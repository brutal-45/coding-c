/*
 * coding-c | Unit 1 - Basics of C
 * 01_hello_world.c
 * --------------------------------------------------------------
 * Your very first C program, annotated with the SECTIONS of a
 * C program (every C program follows this structure).
 *
 * Expected Output:
 *   Hello, World!
 *   This is my first C program.
 * --------------------------------------------------------------
 */

#include <stdio.h>   /* Preprocessor directive: brings in the
                        Standard Input/Output library (printf)  */

/* Global declaration section (variables/functions declared here
   are visible to every function in the file) */

int main(void)       /* main() = entry point of every C program.
                       Execution always starts here.            */
{
    /* Statement section: the actual instructions */
    printf("Hello, World!\n");               /* \n = new line   */
    printf("This is my first C program.\n");

    return 0;        /* Return 0 to the OS = "program finished
                        successfully". Any non-zero value means
                        an error condition.                     */
}
